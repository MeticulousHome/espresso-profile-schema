{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "version": {
            "type": "number",
            "minimum": 1,
            "multipleOf": 1
        },
        "profile_type": {
            "type": "string",
            "enum": [
                "espresso",
                "cleaning"
            ],
            "default": "espresso"
        },
        "name": {
            "type": "string"
        },
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "author": {
            "type": "string"
        },
        "author_id": {
            "type": "string",
            "format": "uuid"
        },
        "previous_authors": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "profile_id": {
                        "type": "string",
                        "format": "uuid"
                    }
                },
                "required": [
                    "name",
                    "author_id",
                    "profile_id"
                ]
            }
        },
        "display": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string",
                    "format": "uri-reference"
                },
                "accentColor": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "description": "Accent color in RGB hex format"
                },
                "shortDescription": {
                    "type": "string",
                    "maxLength": 100
                },
                "description": {
                    "type": "string"
                }
            }
        },
        "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "final_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000
        },
        "variables": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "power",
                            "flow",
                            "pressure",
                            "weight",
                            "time",
                            "piston_position"
                        ]
                    },
                    "value": {
                        "type": "number"
                    }
                },
                "required": [
                    "name",
                    "key",
                    "type",
                    "value"
                ]
            }
        },
        "stages": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "temperature_delta": {
                        "type": "number",
                        "minimum": -100,
                        "maximum": 100
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "power",
                            "flow",
                            "pressure"
                        ]
                    },
                    "dynamics": {
                        "type": "object",
                        "properties": {
                            "points": {
                                "type": "array",
                                "items": {
                                    "type": "array",
                                    "items": {
                                        "anyOf": [
                                            {
                                                "type": "number"
                                            },
                                            {
                                                "type": "string",
                                                "pattern": "^\\$"
                                            }
                                        ]
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                }
                            },
                            "over": {
                                "type": "string",
                                "enum": [
                                    "piston_position",
                                    "time",
                                    "weight"
                                ]
                            },
                            "interpolation": {
                                "type": "string",
                                "enum": [
                                    "none",
                                    "linear",
                                    "curve"
                                ]
                            }
                        },
                        "required": [
                            "points",
                            "over",
                            "interpolation"
                        ]
                    },
                    "exit_triggers": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "weight",
                                        "pressure",
                                        "flow",
                                        "time",
                                        "piston_position",
                                        "power",
                                        "user_interaction"
                                    ]
                                },
                                "value": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "string",
                                            "pattern": "^\\$"
                                        }
                                    ]
                                },
                                "relative": {
                                    "type": "boolean"
                                },
                                "comparison": {
                                    "type": "string",
                                    "enum": [
                                        ">=",
                                        "<="
                                    ]
                                }
                            },
                            "required": [
                                "type",
                                "value"
                            ]
                        }
                    },
                    "nodes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "controllers": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "kind": {
                                                "type": "string",
                                                "enum": [
                                                    "time_reference",
                                                    "position_reference",
                                                    "log_controller",
                                                    "temperature_controller",
                                                    "move_piston_controller",
                                                    "pressure_controller",
                                                    "end_profile"
                                                ]
                                            }
                                        },
                                        "required": [
                                            "kind"
                                        ]
                                    }
                                },
                                "triggers": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "kind": {
                                                "type": "string",
                                                "enum": [
                                                    "exit",
                                                    "water_detection_trigger",
                                                    "timer_trigger",
                                                    "temperature_value_trigger",
                                                    "button_trigger",
                                                    "piston_speed_trigger",
                                                    "pressure_value_trigger"
                                                ]
                                            },
                                            "next_node_id": {
                                                "type": "integer"
                                            }
                                        },
                                        "required": [
                                            "kind",
                                            "next_node_id"
                                        ]
                                    }
                                }
                            },
                            "required": [
                                "id",
                                "controllers",
                                "triggers"
                            ]
                        }
                    },
                    "limits": {
                        "type": "array",
                        "optional": true,
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "pressure",
                                        "flow"
                                    ]
                                },
                                "value": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "string",
                                            "pattern": "^\\$"
                                        }
                                    ]
                                }
                            },
                            "required": [
                                "type",
                                "value"
                            ]
                        }
                    }
                },
                "required": [
                    "name"
                ],
                "oneOf": [
                    {
                        "required": [
                            "key",
                            "type",
                            "dynamics",
                            "exit_triggers"
                        ],
                        "not": {
                            "required": [
                                "nodes"
                            ]
                        }
                    },
                    {
                        "required": [
                            "nodes"
                        ],
                        "not": {
                            "anyOf": [
                                {
                                    "required": [
                                        "key"
                                    ]
                                },
                                {
                                    "required": [
                                        "type"
                                    ]
                                },
                                {
                                    "required": [
                                        "dynamics"
                                    ]
                                },
                                {
                                    "required": [
                                        "exit_triggers"
                                    ]
                                }
                            ]
                        }
                    }
                ]
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "profile_type": {
                        "const": "cleaning"
                    }
                },
                "required": [
                    "profile_type"
                ]
            },
            "then": {
                "required": [
                    "stages"
                ],
                "properties": {
                    "temperature": {
                        "type": "number",
                        "const": 65
                    },
                    "stages": {
                        "type": "array",
                        "items": [
                            {
                                "properties": {
                                    "name": {
                                        "const": "heating"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            },
                            {
                                "properties": {
                                    "name": {
                                        "const": "click to start"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            },
                            {
                                "properties": {
                                    "name": {
                                        "const": "home"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            },
                            {
                                "properties": {
                                    "name": {
                                        "const": "purge"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            },
                            {
                                "properties": {
                                    "name": {
                                        "const": "finished"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            },
                            {
                                "properties": {
                                    "name": {
                                        "const": "cleaning failed"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            },
                            {
                                "properties": {
                                    "name": {
                                        "const": "END_STAGE"
                                    }
                                },
                                "required": [
                                    "nodes"
                                ]
                            }
                        ],
                        "additionalItems": false,
                        "minItems": 7,
                        "maxItems": 7
                    }
                },
                "not": {
                    "required": [
                        "final_weight"
                    ]
                }
            },
            "else": {
                "required": [
                    "final_weight",
                    "stages"
                ],
                "properties": {
                    "stages": {
                        "items": {
                            "not": {
                                "required": [
                                    "nodes"
                                ]
                            }
                        }
                    }
                }
            }
        }
    ],
    "required": [
        "name",
        "id",
        "author",
        "author_id",
        "temperature"
    ]
}
